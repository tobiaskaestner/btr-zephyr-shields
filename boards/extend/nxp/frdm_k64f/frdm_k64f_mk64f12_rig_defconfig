# hwmv2 board extension: `rig` variant defconfig, mirrors the base board's
# own frdm_k64f_defconfig (BOARD_FRDM_K64F selection already comes from the
# base board's Kconfig.frdm_k64f, sourced unconditionally).

CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
CONFIG_SERIAL=y
CONFIG_GPIO=y
CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC=120000000
CONFIG_OSC_EXTERNAL=y

# Enable MPU
CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y
