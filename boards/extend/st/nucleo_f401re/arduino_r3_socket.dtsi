/*
 * Board-DT fragment: NUCLEO-F401RE typed Arduino R3 socket node
 * (rigs Convention 4 — typed sockets live in the board's own devicetree).
 *
 * Layered on top of the REAL upstream nucleo_f401re.dts by the `rig` board
 * EXTENSION variant (board.yml `extend:`) -- included from
 * nucleo_f401re_stm32f401xe_rig.dts, alongside the base board's own legacy
 * arduino_r3_connector.dtsi / st_morpho_connector.dtsi (unmodified, they
 * come along for free via the base include -- harmless duplication, not
 * referenced by this socket). socket,i2c/socket,spi point at the real
 * controllers (&i2c1/&spi1) directly, so no legacy alias is needed.
 *
 * Content identical to the board clone's own arduino_r3_socket.dtsi --
 * copied in here so the extension has no long-term dependency on the
 * clone (deleted in full, slice E4, board-extension-migration.md).
 *
 * gpio-map child pins use the upstream index header
 * (<zephyr/dt-bindings/gpio/arduino-header-r3.h>) — the
 * position-index single source of truth (Convention 4).
 *
 * SPDX-License-Identifier: Apache-2.0
 */

#include <zephyr/dt-bindings/gpio/arduino-header-r3.h>

/ {
	nucleo_ard: arduino_r3: connector_arduino_r3 {
		compatible = "socket,arduino-r3";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map = <ARDUINO_HEADER_R3_A0  0 &gpioa 0  0>,
			   <ARDUINO_HEADER_R3_A1  0 &gpioa 1  0>,
			   <ARDUINO_HEADER_R3_A2  0 &gpioa 4  0>,
			   <ARDUINO_HEADER_R3_A3  0 &gpiob 0  0>,
			   <ARDUINO_HEADER_R3_A4  0 &gpioc 1  0>,
			   <ARDUINO_HEADER_R3_A5  0 &gpioc 0  0>,
			   <ARDUINO_HEADER_R3_D0  0 &gpioa 3  0>,
			   <ARDUINO_HEADER_R3_D1  0 &gpioa 2  0>,
			   <ARDUINO_HEADER_R3_D2  0 &gpioa 10 0>,
			   <ARDUINO_HEADER_R3_D3  0 &gpiob 3  0>,
			   <ARDUINO_HEADER_R3_D4  0 &gpiob 5  0>,
			   <ARDUINO_HEADER_R3_D5  0 &gpiob 4  0>,
			   <ARDUINO_HEADER_R3_D6  0 &gpiob 10 0>,
			   <ARDUINO_HEADER_R3_D7  0 &gpioa 8  0>,
			   <ARDUINO_HEADER_R3_D8  0 &gpioa 9  0>,
			   <ARDUINO_HEADER_R3_D9  0 &gpioc 7  0>,
			   <ARDUINO_HEADER_R3_D10 0 &gpiob 6  0>,
			   <ARDUINO_HEADER_R3_D11 0 &gpioa 7  0>,
			   <ARDUINO_HEADER_R3_D12 0 &gpioa 6  0>,
			   <ARDUINO_HEADER_R3_D13 0 &gpioa 5  0>,
			   <ARDUINO_HEADER_R3_D14 0 &gpiob 9  0>,
			   <ARDUINO_HEADER_R3_D15 0 &gpiob 8  0>;
		socket,i2c = <&i2c1>;
		socket,spi = <&spi1>;
		socket,stackable;
		/* no socket,uart: subset exposure, declared by absence
		 * (matches the legacy board: neither usart1 nor usart2 is
		 * routed as the Arduino serial pins on this Nucleo variant) */

		/* L4-ADC (item 35): all six analog positions reach real ADC1
		 * channels -- single parent, no multi-controller split on this
		 * SoC (STM32F401 has exactly one ADC instance). Channel numbers
		 * sourced from the SAME pinctrl header the real board .dts
		 * itself uses for A0 (nucleo_f401re.dts's own &adc1 node sets
		 * pinctrl-0 to adc1_in0_pa0, confirming A0/PA0 = channel 0):
		 * modules/hal/stm32/dts/st/f4/stm32f401r(d-e)tx-pinctrl.dtsi's
		 * adc1_inN_paX/pbX/pcX node names, N = the ADC1 channel number,
		 * matched against the same A0-A5 -> pin table this file's own
		 * gpio-map above already carries (PA0/PA1/PA4/PB0/PC1/PC0):
		 *   A0 PA0 -> adc1_in0_pa0   (channel 0)
		 *   A1 PA1 -> adc1_in1_pa1   (channel 1)
		 *   A2 PA4 -> adc1_in4_pa4   (channel 4)
		 *   A3 PB0 -> adc1_in8_pb0   (channel 8)
		 *   A4 PC1 -> adc1_in11_pc1  (channel 11)
		 *   A5 PC0 -> adc1_in10_pc0  (channel 10)
		 * &adc1 itself (dts/arm/st/f4/stm32f4.dtsi, compatible
		 * "st,stm32f4-adc"/"st,stm32-adc") declares
		 * #io-channel-cells = <1>, matching this socket's own -- no
		 * pass-thru bits needed (mask fully covers the position cell),
		 * same shape as the seeeduino_lotus grove_a* precedent
		 * (boards/extend/seeed/seeeduino_lotus/grove_sockets.dtsi).
		 * Pin-mux (which pinctrl group actually routes each pin to
		 * ADC1) is board-provided and stays STUBBED here (L4-ADC-brief
		 * Sec 4): the upstream board only wires ONE such group today
		 * (adc1_in0_pa0, for A0); a --build-only twister run needs none
		 * of the rest, and authoring the other five would be board work
		 * with no upstream fact behind it. */
		#io-channel-cells = <1>;
		io-channel-map-mask = <0xffffffff>;
		io-channel-map-pass-thru = <0x00000000>;
		io-channel-map = <ARDUINO_HEADER_R3_A0 &adc1 0>,
				  <ARDUINO_HEADER_R3_A1 &adc1 1>,
				  <ARDUINO_HEADER_R3_A2 &adc1 4>,
				  <ARDUINO_HEADER_R3_A3 &adc1 8>,
				  <ARDUINO_HEADER_R3_A4 &adc1 11>,
				  <ARDUINO_HEADER_R3_A5 &adc1 10>;
	};
};
