/* Shield: Grove Servo (PWM). Uses the Grove signal pin as PWM: the pwms
 * property targets the plug in the PWM function, a 3-cell claim (position,
 * period, flags -- the generic count, which is why the plug node declares
 * none); the expander resolves the position through the socket's
 * pwm-map to a (timer, channel), emits the resolved pwms, enables the
 * timer, and notes the board pin-mux.
 */

#include <dt-bindings/connector/grove.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	shield-templates {
		grove_servo: grove_servo {
			gsv_plug: plug {
				compatible = "shield,plug";
				shield,plugs = "grove";
			};

			pwm {
				servo: servo {
					compatible = "vnd,pwm-servo";
					pwms = <&gsv_plug GROVE_SIG0 20000000 PWM_POLARITY_NORMAL>;	/* 20 ms */
				};
			};
		};
	};
};
