/* Shield: Grove analog light sensor (ADC). Uses the Grove signal pin as an
 * ADC input: io-channels targets the plug in the adc function, a 1-cell
 * claim (position -- the generic count, so the plug node declares none);
 * the expander resolves the position
 * through the socket's adc-map to a (adc, channel). Same multi-function
 * machinery as PWM, different nexus.
 */

#include <dt-bindings/connector/grove.h>

/ {
	shield-templates {
		grove_light: grove_light {
			gl_plug: plug {
				compatible = "shield,plug";
				shield,plugs = "grove";
			};

			adc {
				light: light {
					compatible = "vnd,light-sensor";
					io-channels = <&gl_plug GROVE_SIG0>;
				};
			};
		};
	};
};
