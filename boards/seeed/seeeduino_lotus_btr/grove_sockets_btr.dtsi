/*
 * Board-DT fragment: Seeeduino Lotus (btr-shields clone) typed "socket,grove"
 * nodes (rigs Convention 4 — typed sockets live in the board's own
 * devicetree).
 *
 * These eight "socket,grove" nodes are the SOLE connector description on this
 * clone: bridle's legacy per-connector `*_header` files were dropped (they had
 * no consumer here and only duplicated these sockets — see the .dts header).
 *
 * gpio-map child pins use the GROVE_SIG0/GROVE_SIG1 indices from
 * <dt-bindings/connector/grove.h>. Pin mapping (which SoC pin each position
 * reaches) mirrors scripts/rigexp/common-dts/boards/seeeduino_lotus.rig.dtsi
 * exactly (the expander-side board model this real board must agree with) —
 * including the daisy-lacing (SIG1 of one connector == SIG0 of the next) and
 * the real bridle fact that D2 and D4 share TCC0 channel 0.
 *
 * adc0: is an ADDITIVE second label on the SoC's existing &adc node — the
 * expander's board model (and its _soc-stubs.dtsi) calls the ADC controller
 * "adc0"; the real SAMD21 dtsi (dts/arm/atmel/samd2x.dtsi) labels it "adc"
 * (singular, no controller instance number — SAMD21 has exactly one ADC).
 * `adc0: &adc {};` is the standard Zephyr idiom for attaching an extra label
 * to an existing node (e.g. `zephyr_udc0: &usb0 { ... };` in bridle's own
 * seeeduino_lotus.dts) — it does not redefine or move anything, only gives
 * the expander's emitted `&adc0 { status = "okay"; };` fragment a real node
 * to resolve against.
 *
 * Bridge-A phase 2a: standard-named `pwm-map` / `io-channel-map` nexuses
 * below (on the sockets that carry PWM/ADC-capable positions) encode the
 * SAME position -> controller+channel routing as the expander-side board
 * model's `socket,pwm-map` / `socket,adc-map`
 * (scripts/rigexp/common-dts/boards/seeeduino_lotus_btr.rig.dtsi) — this is
 * the real-DT counterpart that lets `edtlib.Node.maps()` read it natively
 * (`scripts/rigexp/board_edt.py`), same mechanism as `gpio-map` above.
 * Unlike an invented `socket,pwm-map` name (R21 finding, P3 3c: edtlib
 * strips "-map" -> "socket,pwm" -> demands a nonexistent "#socket,pwm-cells"
 * property), the STANDARD names strip to "pwm" / "io-channel", which demand
 * "#pwm-cells" / "#io-channel-cells" — properties &tcc0/&tcc1 (this board's
 * .dts override) and &adc (dts/arm/atmel/samd2x.dtsi) already declare for
 * their own consumer-facing PWM/ADC roles. So the target side needs no
 * invented decoration; only the socket itself must additionally declare its
 * own "#pwm-cells"/"#io-channel-cells" (the child/consumer-facing spec),
 * same as gpio-map already requires "#gpio-cells" here. The emitter is
 * UNCHANGED by this (out of scope, next task): it still emits fully-resolved
 * `pwms`/`io-channels` straight to `&tcc0`/`&adc0`, bypassing the socket's
 * own nexus — these nexus properties exist for the edtlib reader (pass 1)
 * and for any future consumer that resolves through the socket, not for
 * today's emitter.
 */

#include <dt-bindings/connector/grove.h>

adc0: &adc {};

/ {
	/* Digital Grove sockets. D2/D4 both reach TCC0 channel 0 (real bridle
	 * fact, per bridle's GROVE_PWM_D2/D4_PINCTRL in its upstream
	 * grove_d2/d4_connector.dtsi) — the channel clash lotus-pwm-clash
	 * exercises. #pwm-cells = <2> (channel + period, matching &tcc0/&tcc1's
	 * own atmel,sam0-tcc-pwm override in the board .dts); pwm-map-mask fully
	 * matches the position cell and ignores/passes through the second child
	 * cell (period is a target-side fact, not a match key). */
	grove_d2: connector_grove_d2 {
		compatible = "socket,grove";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map = <GROVE_SIG0 0 &porta 14 0>, <GROVE_SIG1 0 &porta 9 0>;

		#pwm-cells = <2>;
		pwm-map-mask = <0xffffffff 0x00000000>;
		pwm-map-pass-thru = <0x00000000 0xffffffff>;
		pwm-map = <GROVE_SIG0 0 &tcc0 0 0>, <GROVE_SIG1 0 &tcc0 1 0>;
	};
	grove_d3: connector_grove_d3 {
		compatible = "socket,grove";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map = <GROVE_SIG0 0 &porta 9 0>, <GROVE_SIG1 0 &porta 8 0>;

		#pwm-cells = <2>;
		pwm-map-mask = <0xffffffff 0x00000000>;
		pwm-map-pass-thru = <0x00000000 0xffffffff>;
		pwm-map = <GROVE_SIG0 0 &tcc0 1 0>, <GROVE_SIG1 0 &tcc0 0 0>;
	};
	grove_d4: connector_grove_d4 {
		compatible = "socket,grove";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map = <GROVE_SIG0 0 &porta 8 0>, <GROVE_SIG1 0 &porta 15 0>;

		/* Real bridle fact -- D2 and D4 share TCC0 ch0. */
		#pwm-cells = <2>;
		pwm-map-mask = <0xffffffff 0x00000000>;
		pwm-map-pass-thru = <0x00000000 0xffffffff>;
		pwm-map = <GROVE_SIG0 0 &tcc0 0 0>, <GROVE_SIG1 0 &tcc0 1 0>;
	};
	grove_d5: connector_grove_d5 {
		compatible = "socket,grove";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map = <GROVE_SIG0 0 &porta 15 0>, <GROVE_SIG1 0 &porta 20 0>;
	};
	grove_d6: connector_grove_d6 {
		compatible = "socket,grove";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map = <GROVE_SIG0 0 &porta 20 0>, <GROVE_SIG1 0 &porta 21 0>;
	};
	grove_d7: connector_grove_d7 {
		compatible = "socket,grove";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map = <GROVE_SIG0 0 &porta 21 0>, <GROVE_SIG1 0 &porta 6 0>;
	};

	/* Analog Grove sockets. io-channel-map nexus, position -> (adc0,
	 * channel), mirroring the expander-side board model's socket,adc-map.
	 * #io-channel-cells = <1> matches &adc's own "#io-channel-cells" (one
	 * cell: channel only, no flags), so the map row's child spec is fully
	 * resolved by the matched entry — no pass-thru bits needed (mask fully
	 * covers the position cell). */
	grove_a0: connector_grove_a0 {
		compatible = "socket,grove";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map = <GROVE_SIG0 0 &porta 2 0>, <GROVE_SIG1 0 &portb 8 0>;

		#io-channel-cells = <1>;
		io-channel-map-mask = <0xffffffff>;
		io-channel-map-pass-thru = <0x00000000>;
		io-channel-map = <GROVE_SIG0 &adc0 0>, <GROVE_SIG1 &adc0 1>;
	};
	grove_a1: connector_grove_a1 {
		compatible = "socket,grove";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map = <GROVE_SIG0 0 &portb 8 0>, <GROVE_SIG1 0 &portb 9 0>;

		#io-channel-cells = <1>;
		io-channel-map-mask = <0xffffffff>;
		io-channel-map-pass-thru = <0x00000000>;
		io-channel-map = <GROVE_SIG0 &adc0 1>, <GROVE_SIG1 &adc0 2>;
	};
	grove_a2: connector_grove_a2 {
		compatible = "socket,grove";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map = <GROVE_SIG0 0 &portb 9 0>, <GROVE_SIG1 0 &porta 4 0>;
	};
};
