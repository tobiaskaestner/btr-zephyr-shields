# nucleo_mux_farm — umbrella-subsystem activation (option A).
#
# Assembly: 1x i2c_mux (ti,tca9548a @0x70 on i2c1) + 4x i2c_sensor
# (vnd,temp0x48, one per mux channel). I2C_TCA954X auto-selects once its DT
# node exists (`depends on DT_HAS_TI_TCA9548A_ENABLED`, default y); the
# umbrellas the shields' drivers need still need opening here.
#
# CONFIG_I2C_TCA954X_{ROOT,CHANNEL}_INIT_PRIO: both default to
# I2C_INIT_PRIORITY (the same value), but the driver's own
# BUILD_ASSERT(CHANNEL_INIT_PRIO > ROOT_INIT_PRIO) requires the channel
# devices to initialize strictly after the mux root — discovered by an
# actual full build (--cmake-only alone doesn't catch it). Values mirror
# zephyr's own tests/drivers/i2c/i2c_tca954x/prj.conf.
CONFIG_I2C=y
CONFIG_SENSOR=y
CONFIG_I2C_TCA954X_ROOT_INIT_PRIO=61
CONFIG_I2C_TCA954X_CHANNEL_INIT_PRIO=62
