# nucleo_datalogger — umbrella-subsystem activation (option A).
#
# Assembly: Adafruit Data Logger (PCF8523 RTC over I2C + SD card over SPI).
# The driver-enabling Kconfig symbols (RTC_PCF8523, SPI_SDHC,
# DISK_DRIVER_SDMMC) all auto-select once their DT node is present
# (`depends on DT_HAS_..._ENABLED`) -- but each sits behind a menuconfig gate
# with no default (RTC, SDHC, DISK_DRIVERS) that only a user/rig can open.
# I2C and SPI are pulled in transitively (RTC_PCF8523 selects I2C; SPI_SDHC
# selects SPI), so only the gates + the SD/disk stack choice need setting
# here.
CONFIG_RTC=y
CONFIG_SDMMC_STACK=y
CONFIG_DISK_ACCESS=y
