/* Grove module: PIR motion sensor (S4-a). Digital module; drives a
 * motion-detected interrupt out on its SIG0 pin (device output = driver). */

#include <dt-bindings/connector/grove.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	rig-shields {
		grove_pir: grove-pir {
			shield,plugs = "grove";
			gpir_plug: plug { #gpio-cells = <2>; };

			gpio {
				gpir_out: motion {
					compatible = "vnd,grove-pir";
					int-gpios = <&gpir_plug GROVE_SIG0 GPIO_ACTIVE_HIGH>;
				};
			};
		};
	};
};
