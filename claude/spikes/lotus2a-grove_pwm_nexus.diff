diff --git i/dts/bindings/connector/grove.yaml w/dts/bindings/connector/grove.yaml
index 83dd575..6a5014b 100644
--- i/dts/bindings/connector/grove.yaml
+++ w/dts/bindings/connector/grove.yaml
@@ -44,6 +44,34 @@ properties:
     required: true
     const: 2
 
+  # SPIKE 2a (temporary): declared inline rather than via `include:
+  # [pwm-nexus.yaml, io-channel-nexus.yaml]` (existing upstream Zephyr
+  # bindings, dts/bindings/pwm/pwm-nexus.yaml + dts/bindings/iio/
+  # io-channel-nexus.yaml -- the same role gpio-nexus.yaml plays for
+  # gpio-map). `include:` merge rejects downgrading an included property's
+  # `required: true` to `false` ("'required' from included file
+  # overwritten"), and not every grove socket carries PWM/ADC (only some SIG
+  # positions reach a timer/ADC channel) -- so these are optional here,
+  # unlike gpio-map which every socket carries. Cell shapes/roles match the
+  # upstream bindings exactly (pwm-map: compound, #pwm-cells: int; same for
+  # io-channel-*), just not required.
+  pwm-map:
+    type: compound
+  pwm-map-mask:
+    type: array
+  pwm-map-pass-thru:
+    type: array
+  "#pwm-cells":
+    type: int
+  io-channel-map:
+    type: compound
+  io-channel-map-mask:
+    type: array
+  io-channel-map-pass-thru:
+    type: array
+  "#io-channel-cells":
+    type: int
+
 gpio-cells:
   - pin
   - flags
