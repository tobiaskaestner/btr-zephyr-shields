/dts-v1/;

#include <dt-bindings/connector/grove.h>

/* Synthetic fixture for the controller-label determinism invariant: a
 * shared controller node carries TWO labels, attached in this textual
 * order -- defining_ctrl on the node itself (as a real SoC dtsi gives a
 * controller its primary label), legacy_alias appended afterward via a
 * bare label-ref (as a later-composed module attaching a legacy per-pin
 * alias would do; dtlib's label list is append-only and never reordered).
 * A pwm-map/gpio-map consumer resolving this node must always see the
 * FIRST-attached label, never whichever alias happened to attach last. */
/ {
	model = "Controller-Label Fixture Board";
	compatible = "vnd,controller-label-fixture";

	defining_ctrl: shared_ctrl {
		#gpio-cells = <2>;
		#pwm-cells = <2>;
	};

	grove_x: connector_grove_x {
		compatible = "socket,grove";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map = <GROVE_SIG0 0 &defining_ctrl 0 0>;

		#pwm-cells = <2>;
		pwm-map-mask = <0xffffffff 0x00000000>;
		pwm-map-pass-thru = <0x00000000 0xffffffff>;
		pwm-map = <GROVE_SIG0 0 &defining_ctrl 0 0>;
	};
};

legacy_alias: &defining_ctrl {};
