/* Board-DT fragment: Seeed Seeeduino Lotus (SAMD21), btr-shields clone
 * (board reference: seeeduino_lotus_btr). Content clone of
 * seeeduino_lotus.rig.dtsi (P3 3c) — same real pin mapping from bridle's
 * grove_d and grove_a connector .dtsi files, same daisy-lacing note. Kept as
 * a separate board name so the expander's `rig,board` lookup
 * (scripts/rigexp/boarddt.py) resolves `seeeduino_lotus_btr` to a rig-enabled
 * board distinct from the original trial board id, matching the real board
 * folder boards/seeed/seeeduino_lotus_btr added alongside it.
 *
 * Note the daisy-lacing: SIG1 of one connector is SIG0 of the next (D3 =
 * porta9 in both grove_d2 and grove_d3). That is real cross-socket net
 * sharing (R13) — the expander resolves both to porta9. Modules here (button,
 * LED) use SIG0 only, so their SIG0 pins are all distinct; the lacing would
 * bite a module that also claimed SIG1.
 *
 * Replaces bridle's per-connector `seeed,grove-connector` nexuses PLUS the
 * "laced" `grove_gpios` flat rail (grove_connectors.dtsi) — the rail existed
 * only to give shields one label to hardcode, which is what forced 64 overlays
 * per shield. With typed sockets a module names its socket instead.
 */

#include <dt-bindings/connector/grove.h>

/ {
	/* Digital Grove sockets. socket,pwm-map (rig-model data, 5-cell rows:
	 * <position 0 &timer channel 0>) mirrors bridle's pwm-map — note D2, D4
	 * both land on tcc0 ch0, so using both as PWM at once is a channel clash. */
	grove_d2: grove-d2 { compatible = "socket,grove"; #gpio-cells = <2>;
		gpio-map = <GROVE_SIG0 0 &porta 14 0>, <GROVE_SIG1 0 &porta 9 0>;
		socket,pwm-map = <GROVE_SIG0 0 &tcc0 0 0>, <GROVE_SIG1 0 &tcc0 1 0>; };
	grove_d3: grove-d3 { compatible = "socket,grove"; #gpio-cells = <2>;
		gpio-map = <GROVE_SIG0 0 &porta 9 0>, <GROVE_SIG1 0 &porta 8 0>;
		socket,pwm-map = <GROVE_SIG0 0 &tcc0 1 0>, <GROVE_SIG1 0 &tcc0 0 0>; };
	grove_d4: grove-d4 { compatible = "socket,grove"; #gpio-cells = <2>;
		gpio-map = <GROVE_SIG0 0 &porta 8 0>, <GROVE_SIG1 0 &porta 15 0>;
		socket,pwm-map = <GROVE_SIG0 0 &tcc0 0 0>, <GROVE_SIG1 0 &tcc0 1 0>; };
	grove_d5: grove-d5 { compatible = "socket,grove"; #gpio-cells = <2>;
		gpio-map = <GROVE_SIG0 0 &porta 15 0>, <GROVE_SIG1 0 &porta 20 0>; };
	grove_d6: grove-d6 { compatible = "socket,grove"; #gpio-cells = <2>;
		gpio-map = <GROVE_SIG0 0 &porta 20 0>, <GROVE_SIG1 0 &porta 21 0>; };
	grove_d7: grove-d7 { compatible = "socket,grove"; #gpio-cells = <2>;
		gpio-map = <GROVE_SIG0 0 &porta 21 0>, <GROVE_SIG1 0 &porta 6 0>; };

	/* Analog Grove sockets. socket,adc-map: position -> (adc, channel). */
	grove_a0: grove-a0 { compatible = "socket,grove"; #gpio-cells = <2>;
		gpio-map = <GROVE_SIG0 0 &porta 2 0>, <GROVE_SIG1 0 &portb 8 0>;
		socket,adc-map = <GROVE_SIG0 0 &adc0 0 0>, <GROVE_SIG1 0 &adc0 1 0>; };
	grove_a1: grove-a1 { compatible = "socket,grove"; #gpio-cells = <2>;
		gpio-map = <GROVE_SIG0 0 &portb 8 0>, <GROVE_SIG1 0 &portb 9 0>;
		socket,adc-map = <GROVE_SIG0 0 &adc0 1 0>, <GROVE_SIG1 0 &adc0 2 0>; };
	grove_a2: grove-a2 { compatible = "socket,grove"; #gpio-cells = <2>;
		gpio-map = <GROVE_SIG0 0 &portb 9 0>, <GROVE_SIG1 0 &porta 4 0>; };
};
