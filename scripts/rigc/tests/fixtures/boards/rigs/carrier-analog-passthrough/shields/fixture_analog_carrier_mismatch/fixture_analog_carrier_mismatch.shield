/* Fixture carrier, require-and-check reject witness (carrier-analog-
 * passthrough-brief.md Sec 5 RULED, criterion 4b): this carrier's OWN
 * plug and exposed socket declare #pwm-cells = <3> -- self-consistent
 * (the row parses fine, 3 child + phandle + 3 parent = 7 words), but
 * DISAGREEING with the resolved parent socket's own #pwm-cells = <2>
 * (carrier_analog_board.dts's ca_socket). compose_socket must refuse
 * this at composition, naming BOTH counts and both sides, rather than
 * silently trusting the carrier's own claim or crashing on the
 * mismatch.
 */

/ {
	shield-templates {
		fixture_analog_carrier_mismatch: fixture_analog_carrier_mismatch {
			shield,plugs = "fixture-analog-nexus";
			plug: plug {
				#gpio-cells = <2>;
				#pwm-cells = <3>;
			};

			ca_out3: ca_out3 {
				compatible = "socket,fixture-analog-nexus";
				#gpio-cells = <2>;
				gpio-map = <0 0 &plug 0 0>;
				#pwm-cells = <3>;
				pwm-map = <0 0 0 &plug 0 0 0>;
			};
		};
	};
};
