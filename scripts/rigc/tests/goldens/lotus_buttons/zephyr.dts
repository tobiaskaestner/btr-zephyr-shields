				reg = < 0x0 0x40000 >;        /* in zephyr/dts/arm/atmel/samx2xx18.dtsi:14 */
				ranges = < 0x0 0x0 0x40000 >; /* in zephyr/dts/arm/atmel/samx2xx18.dtsi:15 */

				/* node '/soc/nvmctrl@41004000/flash@0/partitions' defined in bridle/boards/seeed/seeeduino_lotus/seeeduino_lotus.dts:165 */
				partitions {
					compatible = "fixed-partitions"; /* in bridle/boards/seeed/seeeduino_lotus/seeeduino_lotus.dts:166 */
					#address-cells = < 0x1 >;        /* in bridle/boards/seeed/seeeduino_lotus/seeeduino_lotus.dts:167 */
					#size-cells = < 0x1 >;           /* in bridle/boards/seeed/seeeduino_lotus/seeeduino_lotus.dts:168 */

					/* node '/soc/nvmctrl@41004000/flash@0/partitions/partition@0' defined in bridle/boards/seeed/seeeduino_lotus/seeeduino_lotus.dts:170 */
					boot_partition: partition@0 {
						label = "sam-ba";     /* in bridle/boards/seeed/seeeduino_lotus/seeeduino_lotus.dts:171 */
						reg = < 0x0 0x2000 >; /* in bridle/boards/seeed/seeeduino_lotus/seeeduino_lotus.dts:172 */
						read-only;            /* in bridle/boards/seeed/seeeduino_lotus/seeeduino_lotus.dts:173 */
