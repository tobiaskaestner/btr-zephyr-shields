					/* node '/soc/nvmctrl@41004000/flash@0/partitions/partition@2000' defined in bridle/boards/seeed/seeeduino_lotus/seeeduino_lotus.dts:176 */
					code_partition: partition@2000 {
						label = "code";           /* in bridle/boards/seeed/seeeduino_lotus/seeeduino_lotus.dts:177 */
						reg = < 0x2000 0x3a000 >; /* in bridle/boards/seeed/seeeduino_lotus/seeeduino_lotus.dts:178 */
						read-only;                /* in bridle/boards/seeed/seeeduino_lotus/seeeduino_lotus.dts:179 */
					};

					/* node '/soc/nvmctrl@41004000/flash@0/partitions/partition@3c000' defined in bridle/boards/seeed/seeeduino_lotus/seeeduino_lotus.dts:186 */
					storage_partition: partition@3c000 {
						label = "storage";        /* in bridle/boards/seeed/seeeduino_lotus/seeeduino_lotus.dts:187 */
						reg = < 0x3c000 0x4000 >; /* in bridle/boards/seeed/seeeduino_lotus/seeeduino_lotus.dts:188 */
