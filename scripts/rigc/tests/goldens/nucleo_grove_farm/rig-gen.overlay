#include "rig-gen-includes.dtsi"
/* generated by rigc — do not edit; the rig file is the source of truth (R3)
 * rig: nucleo_grove_farm  board: nucleo_f401re/stm32f401xe/rig
 */

/* carrier-exported sockets, synthesized as gpio-nexus nodes */
/ {
	grove_1_grove_a0: grove_1_grove_a0 {
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map = <0 0 &nucleo_ard 0 0>,
			   <1 0 &nucleo_ard 1 0>;
		#io-channel-cells = <1>;
		io-channel-map-mask = <0xffffffff>;
		io-channel-map-pass-thru = <0x00000000>;
		io-channel-map = <0 &nucleo_ard 0>,
			   <1 &nucleo_ard 1>;
	};
	grove_1_grove_d2: grove_1_grove_d2 {
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map = <0 0 &nucleo_ard 8 0>,
			   <1 0 &nucleo_ard 9 0>;
	};
	grove_1_grove_i2c: grove_1_grove_i2c {
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map = <0 0 &nucleo_ard 5 0>,
			   <1 0 &nucleo_ard 4 0>;
	};
};

&i2c1 {
	sensor_a_gsbme_dev: sensor@76 {
		compatible = "bosch,bme280";
		friendly-name = "Grove THP Sensor V1.0 (BME280)";
		reg = <0x76>;
		status = "okay";
	};
};

/ {
	gpio_keys: gpio_keys {
		compatible = "gpio-keys";
		btn_a_gb_key: btn_a_gb_key {
			label = "btn_a_gb_key";
			zephyr,code = <INPUT_KEY_0>;
			gpios = <&grove_1_grove_d2 0 0x20>;	/* SIG0 */
		};
	};
};

/ {
	light_a {
		light_a_light: light {
			compatible = "vnd,light-sensor";
			io-channels = <&grove_1_grove_a0 0>;	/* SIG0 */
			status = "okay";
		};
	};
};

/* PWM/ADC: enable the resolved controllers; the pin-mux (pinctrl)
 * for each muxed pin is board-provided and must be applied —
 * stubbed here, see the config sheet. */
&adc1 { status = "okay"; };
